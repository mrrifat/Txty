# Server Configuration
PORT=3000
NODE_ENV=development

# Security - CRITICAL: Change this to a strong random secret in production!
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-secret-key-change-this-in-production

# Database
# SQLite database will be created at ./data/txty.db
# For production, ensure ./data directory has proper permissions

# Optional: Application URL (used for SEO and sitemaps)
# APP_URL=https://yourdomain.com

# Optional: Gravatar API Key (for enhanced profile features)
# GRAVATAR_API_KEY=your-gravatar-api-key
